# --- required ---
GEMINI_API_KEY=your-key-here

# --- optional ---
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# sqlite (default) or postgres, e.g. postgresql+psycopg://user:pass@localhost:5432/coach
DATABASE_URL=sqlite:///./app.db
# long random string; REQUIRED when ENV=production
GMAIL_USER="ekionarain6@gmail.com"
GMAIL_APP_PASSWORD="sale1234@#A"
# Optional: defaults to GMAIL_USER
GMAIL_FROM=
# Gmail SMTP defaults; change only if using another mail provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SECRET_KEY=
# development | production
ENV=development
# set true when served over HTTPS (cookies get the Secure flag + HSTS)
COOKIE_SECURE=false
# comma separated origins allowed for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# set true when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
